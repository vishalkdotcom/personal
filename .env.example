RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=hello@vishalk.com
TO_EMAIL=hello@vishalk.com

# GA4 measurement ID (Vite client). Blank/unset disables analytics.
# Cloudflare Pages: set this build env (replaces SvelteKit PUBLIC_GOOGLE_ANALYTICS_ID).
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Hire Signal: show desktop Context Rail hire CTA + mobile floating chip only when true or 1
VITE_HIRE_SIGNAL=true

  },
  "devDependencies": {
    "@solidjs/testing-library": "1.0.0-beta.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.15.0",
    "@vitest/browser-playwright": "4.1.10",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "playwright": "^1.61.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.8.3",
    "vite": "8.1.5",
    "vite-plugin-solid": "3.0.0-next.13",
